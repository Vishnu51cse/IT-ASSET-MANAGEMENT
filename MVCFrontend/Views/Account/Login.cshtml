@model MvcLoginViewModel
@{
    ViewData["Title"] = "Admin Login";
}

<div className="row justify-content-center py-5">
    <div className="col-12 col-md-5">
        <div className="card-custom p-4">
            <div className="text-center mb-4">
                <h4 className="fw-bold">MVC Admin Portal</h4>
                <p className="text-muted small">Sign in to access corporate asset workflows</p>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" className="alert alert-danger py-2"></div>

                <div className="mb-3">
                    <label asp-for="Email" className="form-label fw-semibold">Email Address</label>
                    <input asp-for="Email" className="form-control" />
                    <span asp-validation-for="Email" className="text-danger small"></span>
                </div>

                <div className="mb-4">
                    <label asp-for="Password" className="form-label fw-semibold">Password</label>
                    <input asp-for="Password" className="form-control" />
                    <span asp-validation-for="Password" className="text-danger small"></span>
                </div>

                <button type="submit" className="btn btn-primary w-100 py-2 fw-semibold">Sign In</button>
            </form>

            <div className="mt-4 pt-3 border-top text-center text-muted small">
                Demo Credentials: <strong>admin@company.com</strong> / <strong>Password123!</strong>
            </div>
        </div>
    </div>
</div>
